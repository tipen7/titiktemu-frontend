# Supabase — client-side instance, uses the anon key (respects RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Backend API Gateway
NEXT_PUBLIC_API_URL=http://localhost:4000

# MAPID MAPS basemap — per the PRD's Leaflet + MAPID MAPS integration; get this
# from the MAPID developer dashboard
NEXT_PUBLIC_MAPID_MAPS_API_KEY=your_mapid_maps_key_here